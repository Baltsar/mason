# The key alone is enough: ElevenLabs then speaks the questions, the debrief,
# the teach-back and the recap, and Scribe v2 Realtime hears the answers.
ELEVENLABS_API_KEY=

# Optional. Flash is the cheapest and fastest speech model and is the default.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Optional. Another voice than the default premade one.
ELEVENLABS_VOICE_ID=
# Optional. Fix the language Scribe listens for (sv, en). Empty means detect it.
ELEVENLABS_LANGUAGE=

# Local fallback voice when ElevenLabs is not connected.
APPRENTICE_SYSTEM_VOICE=Samantha

# Optional. Which model writes the project summaries and the weekly recap.
# Left empty, it is your own Claude login through the Claude Code CLI.
# Set a URL and any model that speaks the OpenAI chat format writes them
# instead: one on this Mac (Ollama: http://127.0.0.1:11434/v1) or a provider.
APPRENTICE_LLM_URL=
APPRENTICE_LLM_MODEL=
APPRENTICE_LLM_KEY=
# Optional. The model the three ElevenLabs agents think with.
ELEVENLABS_AGENT_LLM=gemini-2.0-flash
